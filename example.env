GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth — create an app at https://discord.com/developers/applications,
# add the redirect URI http://localhost:8080/login/oauth2/code/discord, and
# enable the "identify" and "email" scopes.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Microsoft OAuth — register an app at https://entra.microsoft.com (App
# registrations), add the redirect URI http://localhost:8080/login/oauth2/code/microsoft,
# and pick "Accounts in any organizational directory and personal Microsoft accounts"
# to match the /common endpoint we configure in application.properties.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# JWT access-token HMAC signing key. MUST be a random secret of >= 32 bytes
# and MUST be overridden in production. Generate with e.g.:
#   openssl rand -base64 48
AMBI_JWT_SIGNING_KEY=

# HMAC secret behind the opaque image-proxy tokens (OpaqueImageUrls) — the URLs
# a SPOT_THE_ANSWER follow-up board's candidate images are served from, which
# must not spell out their S3 key. Same rules as the signing key above: a random
# secret of >= 32 characters, MUST be overridden in production. Unset in dev, an
# insecure default from application.properties applies. Both this and the base
# URL below are left commented so an empty value doesn't override that default.
#AMBI_OPAQUE_IMAGE_SECRET=

# Origin those opaque image URLs are minted absolute against — this backend's
# public base URL (defaults to http://localhost:8080 in dev). Set it empty when a
# single origin fronts both the API and the frontend, to mint relative URLs.
#AMBI_PUBLIC_BASE_URL=

MONGO_URI="mongodb://user:password@host:port/dbname?authSource=admin&serverSelectionTimeoutMS=2000"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="password"

# S3 / Garage — run scripts/init-garage.sh once to generate ACCESS_KEY + SECRET_KEY
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_KEY_NAME="ambi-key"
S3_BUCKET="ambi-images"
S3_ACCESS_KEY="access_key"
S3_SECRET_KEY="secret_key"

LOGGING_LEVEL_ROOT="DEBUG"

# CloudWatch / AWS emulation (LocalStack, see compose.yaml and
# z-docs/decisions/001-observability-stack.md). In dev, point CloudWatch-bound
# AWS SDK clients at LocalStack. In production these are UNSET so the SDK uses
# the real AWS endpoints. (S3 keeps its own S3_ENDPOINT above → Garage.)
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"

# SQS / ElasticMQ — the async image-variant render queue (compose service
# `elasticmq`, queues declared in elasticmq.conf). The queue URL is explicit on
# both sides so nobody calls GetQueueUrl; 000000000000 is the account id
# ElasticMQ synthesizes. In production leave SQS_ENDPOINT unset (the SDK resolves
# the real AWS endpoint) and the keys blank (the instance's IAM role applies).
SQS_ENDPOINT="http://localhost:9324"
SQS_REGION="elasticmq"
SQS_ACCESS_KEY="x"
SQS_SECRET_KEY="x"
SQS_IMAGE_VARIANT_QUEUE_URL="http://localhost:9324/000000000000/ambi-image-variants"

# Shared secret on POST /api/internal/image-variants — the entire authorization
# on the worker's callback, so it MUST be a random value of >= 32 characters in
# production. The two names below are the two ends of the same secret: the
# backend reads the first, the worker container reads the second from this file
# via compose `env_file`. They must match.
AMBI_IMAGE_VARIANT_CALLBACK_SECRET="dev-only-insecure-image-variant-callback-secret-32"
AMBI_WORKER_CALLBACK_SECRET="dev-only-insecure-image-variant-callback-secret-32"

# The worker writes its renditions straight to Garage, so it needs the same key
# pair as S3_ACCESS_KEY/S3_SECRET_KEY above. It is repeated rather than reused
# because compose `env_file` injects names verbatim — the worker only reads
# AMBI_WORKER_*, and the unprefixed names would never reach it.
AMBI_WORKER_S3_ACCESS_KEY_ID="access_key"
AMBI_WORKER_S3_SECRET_ACCESS_KEY="secret_key"
