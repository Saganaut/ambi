GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth — create an app at https://discord.com/developers/applications,
# add the redirect URI http://localhost:8080/login/oauth2/code/discord, and
# enable the "identify" and "email" scopes.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Microsoft OAuth — register an app at https://entra.microsoft.com (App
# registrations), add the redirect URI http://localhost:8080/login/oauth2/code/microsoft,
# and pick "Accounts in any organizational directory and personal Microsoft accounts"
# to match the /common endpoint we configure in application.properties.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MONGO_URI="mongodb://user:password@host:port/dbname?authSource=admin&serverSelectionTimeoutMS=2000"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="password"

# S3 / Garage — run scripts/init-garage.sh once to generate ACCESS_KEY + SECRET_KEY
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_KEY_NAME="ambi-key"
S3_BUCKET="ambi-images"
S3_ACCESS_KEY="access_key"
S3_SECRET_KEY="secret_key"

LOGGING_LEVEL_ROOT="DEBUG"

# CloudWatch / AWS emulation (LocalStack, see compose.yaml and
# z-docs/decisions/001-observability-stack.md). In dev, point CloudWatch-bound
# AWS SDK clients at LocalStack. In production these are UNSET so the SDK uses
# the real AWS endpoints. (S3 keeps its own S3_ENDPOINT above → Garage.)
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"