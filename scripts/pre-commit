#!/usr/bin/env bash
# Pre-commit hook — the FAST verification tier: only cheap, per-commit checks.
# Deliberately excludes the JVM-heavy work (typecheck, type-aware lint, backend
# compile, JDT null-analysis) — those live in the per-feature gate,
# scripts/check-feature.sh, which must be run once per completed feature change
# before committing.
# Install once per clone: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "▶ Frontend lint (oxlint, fast)..."
(cd "$REPO_ROOT/frontend" && npm run lint:fast)

echo "OK - Lint passed."

echo "▶ Stylesheet lint (Stylelint)..."
(cd "$REPO_ROOT/frontend" && npm run lint:css)

echo "OK - Stylelint passed."

echo "▶ Documentation checks (reachability + markdownlint)..."
"$REPO_ROOT/scripts/check-docs.sh"

echo "OK - Docs passed."


echo "🐙🐙🐙 All pre-commit checks passed! 🐙🐙🐙"
