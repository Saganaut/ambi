{
  "name": "ambi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsgo -b --noEmit",
    "dev": "vite",
    "build": "tsgo -b && vite build",
    "lint": "oxlint --type-aware --type-check .",
    "check": "npm run typecheck && npm run lint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "format:css": "prettier --write \"src/**/*.css\"",
    "format:css:check": "prettier --check \"src/**/*.css\"",
    "preview": "vite preview",
    "generate-api": "npx @rtk-query/codegen-openapi openapi-config.cts",
    "generate-validation": "node scripts/generate-validation.mjs",
    "generate-enums": "node scripts/generate-enums.mjs",
    "generate": "npm run generate-api && npm run generate-validation && npm run generate-enums",
    "test": "vitest",
    "test:run": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@floating-ui/react": "^0.27.19",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-router": "^1.168.26",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tiptap/extension-color": "^3.23.1",
    "@tiptap/extension-list-item": "^3.23.1",
    "@tiptap/extension-text-style": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@uiw/react-color": "^2.10.1",
    "@uiw/react-color-block": "^2.10.1",
    "@uiw/react-color-swatch": "^2.10.1",
    "nanoid": "^5.1.11",
    "perfect-freehand": "^1.2.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-easy-crop": "^5.5.7",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^1.4.9",
    "@rolldown/plugin-babel": "^0.2.3",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.3",
    "@svgr/cli": "^8.1.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.3",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "storybook": "^10.4.2",
    "stylelint": "^17.10.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plus": "^0.1.24",
    "vitest": "^4.1.5"
  }
}
