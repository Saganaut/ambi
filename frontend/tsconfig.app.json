{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // "verbatimModuleSyntax": true, disabling as it could cause issues with oxlint?
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    //TODO: Re-enable these at some point and then remove the warnings
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      // Root alias
      "@/*": ["./src/*"],
      "@sb/*": ["./.storybook/*"],
      // Directory-specific aliases
      "@assets/*": ["./src/shared/assets/*"],
      "@shared/*": ["./src/shared/*"],
      "@components/*": ["./src/shared/components/*"],
      "@ui/*": ["./src/shared/components/UIElements/*"],
      "@context/*": ["./src/shared/context/*"],
      "@hooks/*": ["./src/shared/hooks/*"],
      "@pages/*": ["./src/pages/*"],
      "@routes/*": ["./src/routes/*"],
      "@store/*": ["./src/shared/store/*"],
      "@types/*": ["./src/shared/types/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@deck/*": ["./src/features/deck/*"],
      "@account/*": ["./src/features/account/*"],
      "@features/*": ["./src/features/*"],
      "@liveSession/*": ["./src/features/liveSession/*"],
      "@auth/*": ["./src/features/auth/*"]
    }
  },
  "include": ["src", "*.ts", "openapi-config.cts", ".storybook/**/*"]
}
